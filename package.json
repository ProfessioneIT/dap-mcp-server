{
  "name": "dap-mcp-server",
  "version": "0.1.15",
  "description": "MCP server wrapping the Debug Adapter Protocol for AI-driven debugging",
  "keywords": [
    "LLM",
    "MCP",
    "DAP"
  ],
  "repository": {
    "type": "git",
    "url": "ssh://git@forgejo.professioneit.com/ProfessioneIT/dap-mcp-server.git"
  },
  "license": "MIT",
  "author": "Ivan Iraci",
  "type": "module",
  "main": "build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "dap-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "SKILL.md",
    "integrations/claude/dap-debugging"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/debugprotocol": "^1.68.0"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
